#!/bin/bash
#PBS -P xf3
#PBS -q normal
#PBS -l ncpus=48
#PBS -l mem=190GB
#PBS -l walltime=48:00:00
#PBS -l jobfs=200G
#PBS -l storage=gdata/xf3+scratch/xf3
#PBS -l wd
#PBS -j oe
#PBS -M u7406681@anu.edu.au
#PBS -m abe

source /g/data/xf3/miniconda/etc/profile.d/conda.sh
conda activate /g/data/xf3/miniconda/envs/snakemakeREPETv4
configfile=/scratch/xf3/ls9057/Pmelanocephala/REPET/TEdenovo_snakemake/config.yaml

module load singularity

export TMPDIR=$PBS_JOBFS
export SINGULARITY_TMPDIR=$PBS_JOBFS

#snakemake all --use-conda --use-singularity \
#  --singularity-args '--bind /home,/scratch/xf3,/g/data/xf3' \
# -p --configfile $configfile -c 24 -s Snakefile \
# --rerun-incomplete --rerun-triggers mtime --keep-going --omit-from MCL_clustering \
# --max-jobs-per-second 5 --max-status-checks-per-second 5 --latency-wait 60 \
# >> snakemake_hap2.log 2>&1

snakemake all --use-conda --use-singularity \
 --singularity-args '--bind /home,/scratch/xf3,/g/data/xf3,/home/147/ls9057/REPET_patch/DecisionMakerPerConsensus.py:/opt/miniconda/lib/python3.13/site-packages/PASTEC/DecisionMakerPerConsensus.py,/home/147/ls9057/REPET_patch/LaunchMCL.py:/opt/miniconda/lib/python3.13/site-packages/commons/launcher/LaunchMCL.py' \
  -p --configfile $configfile -c 48 -s Snakefile \
 --rerun-incomplete --rerun-triggers mtime --keep-going --omit-from MCL_clustering \
 --max-jobs-per-second 5 --max-status-checks-per-second 5 --latency-wait 60 \
 >> snakemake_hap2.log 2>&1  